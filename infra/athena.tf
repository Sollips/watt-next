# Athena query results: disposable, so force_destroy and no versioning
module "athena_results" {
  source        = "../modules/secure_bucket"
  bucket_prefix  = "watt-next-athena-results-"
  force_destroy = true # results can be regenerated by re-running the query
  # versioning_enabled not set → default false
}

# Query results are disposable: delete them after a week
resource "aws_s3_bucket_lifecycle_configuration" "athena_results" {
  bucket = module.athena_results.name

  rule {
    id     = "expire-query-results"
    status = "Enabled"
    filter {}

    expiration {
      days = 7
    }
  }
}